    <shortcut
        android:shortcutId="open_today"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_open_short"
        android:shortcutLongLabel="@string/shortcut_open_long">
        <intent
            android:action="de.stefansturm.ripple.OPEN_TODAY"
            android:targetPackage="de.stefansturm.ripple"
            android:targetClass="com.stefansturm.ripple.MainActivity" />
    </shortcut>
