        android:shortcutId="log_default"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_log_short"
        android:shortcutLongLabel="@string/shortcut_log_long">
        <intent
            android:action="de.stefansturm.ripple.LOG_DEFAULT_INTENT"
            android:targetPackage="de.stefansturm.ripple"
            android:targetClass="com.stefansturm.ripple.MainActivity" />
